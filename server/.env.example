# Railway injeta DATABASE_URL automaticamente quando ligas o plugin Postgres.
# Para correr localmente, aponta para um Postgres teu (local ou o próprio da Railway).
DATABASE_URL=postgres://user:password@localhost:5432/monco3d

# String aleatória longa — usada para assinar os tokens JWT dos professores.
JWT_SECRET=troca-me-por-uma-string-aleatoria-longa

# Origem(ns) permitidas a chamar esta API (o site estático do Monco3D).
# Várias origens separadas por vírgula, ex: https://3d.monco.io,http://localhost:5500
ALLOWED_ORIGIN=https://3d.monco.io

PORT=3001
